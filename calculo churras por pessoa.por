programa {
  funcao inicio() {
  //entedimento do problema
  //calcular itens por pessoa
  //informações e variveís
  real carne
  inteiro cerveja, agua, refri, pessoa
  //entrada de dados
  escreva("Quanta pessoas são: ")
  leia(pessoa)
  //processamento
  carne = pessoa * 0.5
  cerveja = pessoa * 1
  agua = pessoa * 0.5
  refri = pessoa * 0.2
   //saída
   escreva("Carnes necessárias: ")
   escreva(carne)
   escreva("\nCervejas necessárias: ")
   escreva(cerveja)
   escreva("\nÀgua necessárias: ")
   escreva(agua)
   escreva("\nRefris necessários: ")
   escreva(refri)

  }
}

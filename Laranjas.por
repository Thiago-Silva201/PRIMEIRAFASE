programa {
  funcao inicio() {
  //entedimento do problema
  //saber quantas laranjas venderam
  //informações e variantes
  inteiro laranjasIniciais, laranjasFinais, laranjas
  //entrada de dados
  escreva("Quantidade Inicial De laranjas: ")
  leia(laranjasIniciais)
  escreva("Quantidade Final De laranjas: ")
  leia(laranjasFinais)
  escreva("Foram vendidas: ")
  //precessamento
  laranjas = laranjasIniciais - laranjasFinais
  //saída 
  escreva(laranjas)
  }
}

programa {
  funcao inicio() {
  //entedimento do problema
  //calcular o valor de vale trocas, considerando preço e quantidade
  //infos e variantes
  inteiro quantidade
  real valeTroca, preco
  //entrada de dados
  escreva("Preço de cada par de calçados: ")
  leia(quantidade)
  escreva("Quantidade de pares trocados: ")
  leia(preco) 
  escreva("Total de Vale Trocas: ")
  //procesamento
  valeTroca = quantidade * preco
  //saidas  
  escreva(valeTroca)
  }
}

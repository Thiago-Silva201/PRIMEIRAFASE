programa {
  funcao inicio() {
  //entedimento do problema
  //mostra quanto falta para pagar os custos mensais
  //informações e variantes
  inteiro custosMensais, recibo, resto
  //entrada de dados
  escreva("Custos Mensais: ")
  leia(custosMensais)
  escreva("Quanto foi recebido: ")
  leia(recibo)
  escreva("Sobrou: ")
  //processamento
  resto = recibo - custosMensais
  //saída
  escreva(resto)
  }
}

programa {
  funcao inicio() {
  //entedimento do problema
  //calcular salario do junin por dia/semana
  //informações e variantes
  real salario, recebePordia, recebePorsemana
  inteiro dias
  //entrada de dados
  escreva("Salario: ")
  leia(salario)
  escreva("Dias Trabalhados: ")
  leia(dias)
  escreva("Recebe por dia: ")
  escreva("Recebe Por semana: ")
  //procesamento
  recebePordia = salario / dias
  //saída
  escreva(recebePordia)

  }
}

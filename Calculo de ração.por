programa {
  funcao inicio() {
  //entedimento do problema
  //criar um programa para calcular o preço da ração por kg
  //informações e variveís
  real gramas, preco
  //entrada de dados
  escreva("Quantos Gramas de ração:R$ ")
  leia(gramas)
  //processamento
preco = gramas / 100
  //saída
  escreva("O preço é:R$ ")
  escreva(preco)



  }
}

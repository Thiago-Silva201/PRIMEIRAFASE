programa {
  funcao inicio() {
   //entedimento do problema
   //Crie um programa que lê quanto ele pagou em uma obra e calcule qual preço ele deve vender
   //informações e variveís
   real obras
   //entrada de dados
   escreva("Qual o valor de custo da obra:R$ ")
   leia(obras)
   //processamento
   obras = obras * 3
   //saída
   escreva("O valor para revender vai ser:R$ ")
   escreva(obras)

  }
}

programa {
  funcao inicio() {
  //entedimento do problema
  //calcular quantos funcionarios tem na empresa
  //infos e variantes
  inteiro clt, estagiarios, pj, devs
  //entrada de dados
  escreva("Quantos clt: ")
  leia(clt)
  escreva("Quantos estagiarios: ")
  leia(estagiarios)
  escreva("Quantos pj: ")
  leia(pj)
  escreva("total de devs: ")
  //procesamento
  devs = clt + estagiarios + pj
  //saida
  escreva(devs)
  }
}

programa {
  funcao inicio() {
  //entendimento do problema
  //infos e variaveis
  inteiro hora, minuto
  //entrada de dados
  escreva("hora do começo: ")
  leia(hora)
  escreva("minuto do começo: ")
  leia(minuto)
  //processamento
  minuto = minuto + 20
  //saida
  escreva("recreio termina ")
  escreva(hora)
  escreva(minuto)
  escreva("\noque acontece com quem chega depois do horario? ")
  escreva("\nvai precisar da autorizão pra entrar em sala")
  }
}

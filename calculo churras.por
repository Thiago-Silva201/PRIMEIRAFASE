programa {
  funcao inicio() {
   //entedimento do problema
   //calcular de pessoa, e calcular o produto
   //infos e variaveís
   inteiro pessoas
   real agua, cerveja, refri, carne
   //entrada de dados
   escreva("Quantas pessoas: ")
   leia(pessoas)
   escreva("quantas águas: ")
   leia(agua)
   escreva("Quantas cerveja: ")
   leia(cerveja)
   escreva("Quanto refri: ")
   leia(refri)
   escreva("Quantas carnes: ")
   leia(carne)
   //processamento
   carne = pessoas * 0.5
   cerveja = pessoas * 1
   agua = pessoas * 0.5
   refri = pessoas * 0.2
   //saída
  escreva("carne: " + carne)
  escreva("\ncerveja: " + cerveja)
  escreva("\nrefri: " + refri)




  }
}
